{
  "name": "Switch Tabs",
  "manifest_version": 3,
  "version": "0.2.0",
  "background": {
    "service_worker": "tab_listener.js",
    "type": "module"
  },
  "commands": {
    "previous-tab": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "MacCtrl+Q"
      },
      "description": "Switch to the previously active tab"
    }
  },
  "icons": {
    "128": "logo128.png"
  },
  "permissions": ["storage"]
}
